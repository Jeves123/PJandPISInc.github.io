@model PJ_P_Installation_Management_System.Models.CustomerPurchase

@{
    ViewData["Title"] = "Payment / Invoice";
    var productTotal = Model.CustomerPurchaseItems.Sum(i => i.Price * i.Quantity);
    var laborFee = Model.LaborFeeAmount ?? 0;
    var grandTotal = productTotal + laborFee;
}

<div class="container mt-4" style="max-width:820px;">
    <div class="card shadow-sm rounded-3 border-0">
        <div class="card-body p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-primary mb-0">
                    <i class="bi bi-receipt"></i> Invoice / Payment
                </h4>
                <span class="text-muted small">Purchase Order: <strong>@Model.OrderId</strong></span>
            </div>

            <!-- Customer / Project -->
            <p><strong>Customer / Project:</strong> @Model.CustomerProject</p>
            <p><strong>Purchase Date:</strong> @Model.PurchaseDate.ToString("yyyy-MM-dd")</p>

            <!-- Products Table -->
            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered table-hover align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Price</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var item in Model.CustomerPurchaseItems)
                        {
                            <tr>
                                <td>@item.Product.Name</td>
                                <td class="text-end">₱@item.Price</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">₱@(item.Price * item.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="small">
                        <tr class="fw-semibold">
                            <td colspan="3" class="text-end">Subtotal</td>
                            <td class="text-end">₱@productTotal</td>
                        </tr>

                        @if (Model.Status == "Installation" && Model.LaborFeeAmount.HasValue)
                        {
                            <tr>
                                <td colspan="3" class="text-end">Labor Fee</td>
                                <td class="text-end">₱@Model.LaborFeeAmount</td>
                            </tr>
                        }

                        <tr class="fw-bold table-primary">
                            <td colspan="3" class="text-end">Grand Total</td>
                            <td class="text-end">₱@grandTotal</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Payment Form -->
            <form asp-action="ConfirmPayment" method="post">
                <input type="hidden" name="CustomerPurchaseId" value="@Model.CustomerPurchaseId" />
                <input type="hidden" name="GrandTotal" value="@grandTotal" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Amount Received</label>
                    <input type="number" step="0.01" min="0" name="AmountReceived" id="amountReceived"
                           class="form-control" required oninput="calculateChange()" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Change</label>
                    <input type="text" id="changeDisplay" class="form-control" readonly value="₱0.00" />
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill shadow">
                        <i class="bi bi-arrow-left-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4 rounded-pill ms-2">
                        <i class="bi bi-cash"></i> Complete Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function calculateChange() {
        let received = parseFloat(document.getElementById("amountReceived").value) || 0;
        let grandTotal = @grandTotal;
        let change = received - grandTotal;
        document.getElementById("changeDisplay").value = "₱" + change.toFixed(2);
    }
</script>
