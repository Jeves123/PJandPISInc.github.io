@model PJ_P_Installation_Management_System.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<div class="container mt-4">
    <div class="card shadow rounded-4 border-0">
        <div class="card-body p-4 p-md-5">

            <!-- Header -->
            <h2 class="mb-4 text-primary">
                <i class="bi bi-truck"></i> Delivery Details
            </h2>

            <!-- Purchase Info -->
            <dl class="row g-4">
                <dt class="col-sm-3 fw-bold text-secondary">
                    <i class="bi bi-hash"></i> Order Number
                </dt>
                <dd class="col-sm-9">@Model.OrderNumber</dd>

                <dt class="col-sm-3 fw-bold text-secondary">
                    <i class="bi bi-upc-scan"></i> Tracking Number
                </dt>
                <dd class="col-sm-9">@Model.DeliveryTrackingNumber</dd>

                <dt class="col-sm-3 fw-bold text-secondary">
                    <i class="bi bi-calendar-event"></i> Purchase Date
                </dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PurchaseDate)</dd>

                <dt class="col-sm-3 fw-bold text-secondary">
                    <i class="bi bi-building"></i> Supplier
                </dt>
                <dd class="col-sm-9">@Model.Supplier?.CompanyName</dd>
            </dl>

            <hr class="my-4" />

            <!-- Purchase Items -->
            <h4 class="mb-3 text-primary">
                <i class="bi bi-box-seam"></i> Purchase Items
            </h4>

            <form method="post" asp-action="UpdateDeliveries">
                <input type="hidden" name="purchaseId" value="@Model.PurchaseId" />

                <table class="table table-bordered shadow-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th>Product</th>
                            <th>Ordered Qty</th>
                            <th>Delivered Qty</th>
                            <th>Missing</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.PurchaseItems != null && Model.PurchaseItems.Any())
                        {
                            int index = 0;
                            foreach (var item in Model.PurchaseItems)
                            {
                                var missing = item.Quantity - item.DeliveredQuantity;
                                string statusClass = "";
                                string statusText = "";

                                if (item.DeliveredQuantity >= item.Quantity)
                                {
                                    statusClass = "bg-success";
                                    statusText = "Delivered";
                                }
                                else
                                {
                                    statusClass = "bg-warning";
                                    statusText = "On Delivery";
                                }

                                <tr>
                                    <td>@item.Product?.Description</td>
                                    <td>@item.Product?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>
                                        @if (Model.IsCompleted)
                                        {
                                            @item.DeliveredQuantity
                                        }
                                        else
                                        {
                                            <input type="hidden" name="purchaseItemIds[@index]" value="@item.PurchaseItemId" />
                                            <input type="number" name="deliveredQuantities[@index]"
                                                   value="@item.DeliveredQuantity"
                                                   class="form-control"
                                                   min="0"
                                                   max="@item.Quantity"
                                                   style="width: 90px" />
                                        }
                                    </td>


                                    <td>@missing</td>
                                    <td>
                                        <span class="badge @statusClass px-3 py-2 rounded-pill">
                                            @statusText
                                        </span>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No purchase items available.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr class="my-4" />

                <!-- Actions -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>

                    <div class="d-flex gap-2">
@*                         <a asp-action="Edit" asp-route-id="@Model?.PurchaseId"
                           class="btn btn-warning rounded-pill px-4">
                            <i class="bi bi-pencil"></i> Edit
                        </a> *@
                        @if (!Model.IsCompleted)
                        {
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-save"></i> Save All Changes
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                Purchase Completed
                            </span>
                        }

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Quick update buttons
            $('.update-btn').click(function() {
                const btn = $(this);
                const purchaseItemId = btn.data('id');
                const newValue = parseInt(btn.data('value'));
                const input = $(`input[name*='deliveredQuantities'][data-id='${purchaseItemId}']`);

                // Validate new value
                const min = parseInt(input.attr('min'));
                const max = parseInt(input.attr('max'));

                if (newValue >= min && newValue <= max) {
                    input.val(newValue);

                    // Update minus button
                    $(`.update-btn[data-id='${purchaseItemId}'][data-value='${newValue - 1}']`)
                        .data('value', newValue - 1)
                        .prop('disabled', newValue - 1 < min);

                    // Update plus button
                    $(`.update-btn[data-id='${purchaseItemId}'][data-value='${newValue + 1}']`)
                        .data('value', newValue + 1)
                        .prop('disabled', newValue + 1 > max);
                }
            });

            // Initialize button states
            $('input[type="number"]').each(function() {
                const value = parseInt($(this).val());
                const min = parseInt($(this).attr('min'));
                const max = parseInt($(this).attr('max'));
                const id = $(this).attr('data-id');

                // Set initial button states
                $(`.update-btn[data-id='${id}'][data-value='${value - 1}']`)
                    .prop('disabled', value - 1 < min);

                $(`.update-btn[data-id='${id}'][data-value='${value + 1}']`)
                    .prop('disabled', value + 1 > max);
            });
        });
    </script>
}