@model IEnumerable<PJ_P_Installation_Management_System.Models.Staff>

@{
    ViewData["Title"] = "Staff";
    int pageSize = 5;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalStaff = ViewBag.TotalStaff ?? 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">Staff Management</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Staff
        </a>
    </div>

    <!-- 🔍 Search Bar -->
    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group input-group-sm" style="max-width: 300px;">
            <input type="text" name="searchString" value="@ViewBag.SearchString"
                   class="form-control" placeholder="Search staff..." />
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(Model => Model.StaffId)</th>
                            <th>@Html.DisplayNameFor(model => model.FullName)</th>
                            <th>@Html.DisplayNameFor(model => model.Position)</th>
                            <th>@Html.DisplayNameFor(model => model.Location)</th>
                            <th>@Html.DisplayNameFor(model => model.ContactNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StaffId.ToString("D4")</td>
                                <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Position)</td>
                                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                                <td>@Html.DisplayFor(modelItem => item.ContactNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.StaffId" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.StaffId" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.StaffId" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- 📄 Pagination on the right -->
                <div class="d-flex justify-content-end mt-3">
                    <nav aria-label="Staff pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(currentPage - 1)"
                                   asp-route-searchString="@ViewBag.SearchString">Previous</a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-searchString="@ViewBag.SearchString">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(currentPage + 1)"
                                   asp-route-searchString="@ViewBag.SearchString">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>
    </div>
</div>


<style>
    .table {
        border-radius: 8px;
        overflow: hidden;
    }

        .table th {
            background-color: #4CAF50;
            color: white;
            font-weight: 500;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(76, 175, 80, 0.1);
    }

    .btn-group .btn {
        margin-right: 5px;
        border-radius: 4px;
        font-size: 0.85rem;
        padding: 0.25rem 0.5rem;
    }

        .btn-group .btn:last-child {
            margin-right: 0;
        }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .card {
        border-radius: 8px;
        border: none;
    }

    .card-body {
        padding: 1.5rem;
    }

    .bi {
        margin-right: 4px;
    }
</style>