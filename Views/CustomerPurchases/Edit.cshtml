@model PJ_P_Installation_Management_System.Models.CustomerPurchase

@{
    ViewData["Title"] = "Edit Customer Purchase";
}

<div class="container mt-4" style="max-width:900px;">
    <h2 class="mb-4 text-primary">Edit Customer Purchase</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CustomerPurchaseId" />

        <!-- Basic Info -->
        <div class="mb-2">
            <label asp-for="OrderId" class="form-label fw-bold"></label>
            <input asp-for="OrderId" class="form-control form-control-sm" />
        </div>

        <div class="mb-2">
            <label asp-for="CustomerProject" class="form-label fw-bold"></label>
            <input asp-for="CustomerProject" class="form-control form-control-sm" />
        </div>

        <div class="mb-2">
            <label asp-for="PurchaseDate" class="form-label fw-bold"></label>
            <input asp-for="PurchaseDate" type="date" class="form-control form-control-sm" />
        </div>

        <!-- Status -->
        <div class="mb-2">
            <label asp-for="Status" class="form-label fw-bold"></label>
            <select asp-for="Status" class="form-select form-select-sm" asp-items="ViewBag.StatusList" id="statusSelect"></select>
        </div>

        <!-- Installation Fields -->
        <div id="installation-fields" class="row g-2 mb-2" style="display:none;">
            <div class="col-md-6">
                <label asp-for="InstallationLocation" class="form-label fw-bold"></label>
                <input asp-for="InstallationLocation" class="form-control form-control-sm" />
            </div>
            <div class="col-md-6">
                <label asp-for="InstallationDate" class="form-label fw-bold"></label>
                <input asp-for="InstallationDate" type="date" class="form-control form-control-sm" />
            </div>
        </div>

        <!-- Labor Fee (only if Installation) -->
        <div id="laborfee-field" class="mb-2" style="display:none;">
            <label asp-for="LaborFeeAmount" class="form-label fw-bold">Labor Fee (₱)</label>
            <input asp-for="LaborFeeAmount" type="number" step="0.01" class="form-control form-control-sm" />
            <span asp-validation-for="LaborFeeAmount" class="text-danger"></span>
        </div>


        <div class="mb-2">
            <label asp-for="PaymentStatus" class="form-label fw-bold"></label>
            <select asp-for="PaymentStatus" class="form-select form-select-sm" asp-items="ViewBag.PaymentStatuses"></select>
        </div>

        <div class="mb-2">
            <label asp-for="AmountReceived" class="form-label fw-bold"></label>
            <input asp-for="AmountReceived" type="number" step="0.01" class="form-control form-control-sm" />
        </div>

        <!-- Proof Image -->
        <div class="mb-2">
            <label class="form-label fw-bold">Upload Proof of Payment</label>
            <input type="file" name="ProofImage" class="form-control form-control-sm" accept="image/*" />

                <!-- Modal -->
                <div class="modal fade" id="proofModal" tabindex="-1" aria-labelledby="proofModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-md">
                        <div class="modal-content rounded-3 shadow-sm">
                            <div class="modal-header">
                                <h6 class="modal-title" id="proofModalLabel">Payment Proof</h6>
                                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Save -->
        <div class="mt-3 d-flex justify-content-end">
            <a asp-action="Index" class="btn btn-secondary btn-sm px-3 rounded-pill">Back</a>
            <button type="submit" class="btn btn-success btn-sm px-3 rounded-pill">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const statusSelect = document.getElementById("statusSelect");
            const installationFields = document.getElementById("installation-fields");
            const laborFeeField = document.getElementById("laborfee-field");

            function toggleFields() {
                if (statusSelect.value === "Installation") {
                    installationFields.style.display = "flex";
                    laborFeeField.style.display = "block";
                } else {
                    installationFields.style.display = "none";
                    laborFeeField.style.display = "none";
                }
            }

            toggleFields();
            statusSelect.addEventListener("change", toggleFields);
        });
    </script>
}
