@model PJ_P_Installation_Management_System.Models.Product

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Product</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ProductId" />

            <!-- Product Name -->
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Product Description (Dropdown) -->
            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <select asp-for="Description" class="form-control" asp-items="ViewBag.DescriptionList">
                    <option value="">-- Select Description --</option>
                </select>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Supplier (Single select) -->
            <div class="form-group mb-3">
                <label for="SupplierId" class="form-label">Supplier</label>
                <select id="SupplierId" name="SupplierId" class="form-control" asp-items="ViewBag.Suppliers">
                    <option value="">-- Select Supplier --</option>
                </select>
                <span class="text-muted">Each product can only have one supplier.</span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary rounded-pill px-4" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
        <i class="bi bi-arrow-left-circle"></i> Back to List
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
