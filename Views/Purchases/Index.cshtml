@model IEnumerable<PJ_P_Installation_Management_System.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">Purchase Management</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Purchase
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- 🔍 Compact Search Bar -->
            <form asp-action="Index" method="get" class="mb-3">
                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           class="form-control" placeholder="Search..." />
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>


            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Tracking Number</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var purchase in Model)
                        {
                            <tr>
                                <td>@purchase.OrderId</td>
                                <td>@purchase.DeliveryTrackingNumber</td>
                                <td>@purchase.PurchaseDate.ToShortDateString()</td>
                                <td>
                                    @if (purchase.Supplier != null)
                                    {
                                        <span class="badge bg-primary">@purchase.Supplier.CompanyName</span>
                                    }
                                    else if (purchase.PurchaseItems != null && purchase.PurchaseItems.Any())
                                    {
                                        var suppliers = purchase.PurchaseItems
                                        .SelectMany(pi => pi.Product.ProductSuppliers.Select(ps => ps.Supplier.CompanyName))
                                        .Distinct();

                                        foreach (var supplierName in suppliers)
                                        {
                                            <span class="badge bg-secondary">@supplierName</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No supplier</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@purchase.PurchaseId" class="btn btn-sm btn-info">
                                            <i class="bi bi-truck"></i> Delivery
                                        </a>

@*                                         <a asp-action="Edit" asp-route-id="@purchase.PurchaseId" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a> *@

                                        <a asp-action="Delete" asp-route-id="@purchase.PurchaseId"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this purchase?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 📑 Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    Showing @((ViewBag.CurrentPage - 1) * 5 + 1)
                    to @(Math.Min(ViewBag.CurrentPage * 5, ViewBag.TotalPurchases))
                    of @ViewBag.TotalPurchases results
                </div>

                <nav>
                    <ul class="pagination mb-0">
                        <!-- Previous -->
                        <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.SearchString">Previous</a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@ViewBag.SearchString">@i</a>
                            </li>
                        }

                        <!-- Next -->
                        <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.SearchString">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<style>
    .table {
        border-radius: 8px;
        overflow: hidden;
    }

        .table th {
            background-color: #4CAF50;
            color: white;
            font-weight: 500;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(76, 175, 80, 0.1);
    }

    .btn-group .btn {
        margin-right: 5px;
        border-radius: 4px;
        font-size: 0.85rem;
        padding: 0.25rem 0.5rem;
    }

        .btn-group .btn:last-child {
            margin-right: 0;
        }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .card {
        border-radius: 8px;
        border: none;
    }

    .card-body {
        padding: 1.5rem;
    }

    .bi {
        margin-right: 4px;
    }
</style>