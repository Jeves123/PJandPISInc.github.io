@model IEnumerable<PJ_P_Installation_Management_System.ViewModel.FinancialReportViewModel>

@{
    ViewData["Title"] = "Financial Report";
    var grandTotal = ViewBag.GrandTotal ?? 0;
}

<div class="container mt-4">
    <div class="card shadow rounded-4 border-0">
        <div class="card-body p-4">
            <h2 class="mb-4 text-primary">
                <i class="bi bi-cash-stack"></i> Financial Report
            </h2>

            <!-- Date Range Filter -->
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">From</label>
                    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">To</label>
                    <input type="date" name="to" value="@ViewBag.To" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>


            <!-- Report Table -->
            <table class="table table-bordered table-hover shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>Purchase Date</th>
                        <th>Purchase Order</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.PurchaseOrder</td>
                                <td class="text-end">@item.Total.ToString("C")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                No purchases found for the selected date range.
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="2" class="fw-bold text-end">Grand Total:</td>
                        <td class="fw-bold text-end">@grandTotal.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
