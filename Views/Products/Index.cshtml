@model IEnumerable<PJ_P_Installation_Management_System.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">Products Management</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Product
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <form asp-action="Index" method="get" class="d-flex">
                    <div class="input-group">
                        <input type="text" name="searchString" value="@ViewBag.SearchString"
                               class="form-control" placeholder="Search products..." />

                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.ProductId)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Unit)</th>
                            <th>Price</th>
                            <th>Supplier</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var ps = item.ProductSuppliers?.FirstOrDefault();

                            <tr>
                                <td>@item.ProductId.ToString("D3")</td>
                                <td>@item.Description</td>
                                <td>@item.Name</td>
                                <td>@item.Unit</td>
                                <td>
                                    @if (ps != null)
                                    {
                                        @ps.Price.ToString("N2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">No price</span>
                                    }
                                </td>
                                <td>
                                    @if (ps != null)
                                    {
                                        @ps.Supplier.CompanyName
                                    }
                                    else
                                    {
                                        <span class="text-muted">No supplier</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info text-white">
                                            <i class="bi bi-info-circle"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        Showing @((ViewBag.CurrentPage - 1) * 5 + 1)
                        to @(Math.Min(ViewBag.CurrentPage * 5, ViewBag.TotalProducts))
                        of @ViewBag.TotalProducts results
                    </div>

                    <nav>
                        <ul class="pagination mb-0">
                            <!-- Previous button -->
                            <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)">Previous</a>
                            </li>

                            <!-- Numbered pages -->
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                                </li>
                            }

                            <!-- Next button -->
                            <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>
    </div>
</div>


    @section Scripts {
        <script>
            document.querySelectorAll('.supplier-select').forEach(select => {
                select.addEventListener('change', function () {
                    const supplierId = this.value;
                    const price = this.selectedOptions[0].getAttribute('data-price');
                    const productId = this.getAttribute('data-product-id');

                    const priceInput = document.querySelector(`.price-input[data-product-id='${productId}']`);
                    if (priceInput) {
                        priceInput.value = price;
                        priceInput.setAttribute('data-supplier-id', supplierId);

                        const saveBtn = document.querySelector(`.save-price-btn[data-product-id='${productId}']`);
                        if (saveBtn) {
                            saveBtn.setAttribute('data-supplier-id', supplierId);
                        }
                    }
                });
            });

            // Save price when button is clicked
            document.querySelectorAll('.save-price-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const productId = parseInt(this.getAttribute('data-product-id'));
                    const supplierId = parseInt(this.getAttribute('data-supplier-id'));
                    const priceInput = document.querySelector(`.price-input[data-product-id='${productId}'][data-supplier-id='${supplierId}']`);
                    const newPrice = parseFloat(priceInput.value);

                    if (Number.isNaN(productId) || Number.isNaN(supplierId)) return;

                    fetch(`/Products/UpdatePrice`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, supplierId, price: newPrice })
                    })
                    .then(res => {
                        if (res.ok) {
                            alert("Price updated successfully!");
                        } else {
                            alert("Failed to update price.");
                        }
                    })
                    .catch(() => {
                        alert("Error while saving price.");
                    });
                });
            });
        </script>
    }




<style>
    .table {
        border-radius: 8px;
        overflow: hidden;
    }

        .table th {
            background-color: #4CAF50;
            color: white;
            font-weight: 500;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(76, 175, 80, 0.1);
    }

    .btn-group .btn {
        margin-right: 5px;
        border-radius: 4px;
        font-size: 0.85rem;
        padding: 0.25rem 0.5rem;
    }

        .btn-group .btn:last-child {
            margin-right: 0;
        }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .card {
        border-radius: 8px;
        border: none;
    }

    .card-body {
        padding: 1.5rem;
    }

    .bi {
        margin-right: 4px;
    }
</style>

