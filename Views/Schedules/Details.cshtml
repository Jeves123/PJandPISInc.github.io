@model PJ_P_Installation_Management_System.Models.Schedule

<h1>Schedule Details</h1>

<div class="card shadow-sm p-3">
    <h5 class="mb-3">General Info</h5>
    <dl class="row small">
        <dt class="col-sm-3">Scheduled Date</dt>
        <dd class="col-sm-9">@Model.ScheduledDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">End Date</dt>
        <dd class="col-sm-9">@Model.EndDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Task</dt>
        <dd class="col-sm-9">@Model.TaskDescription</dd>

        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9">@Model.Location</dd>
    </dl>

    <h5 class="mt-4">Assigned Staff</h5>
    <div style="max-height: 250px; overflow-y: auto;" class="border rounded p-2 bg-light">
        @if (Model.StaffAssignments != null && Model.StaffAssignments.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var sa in Model.StaffAssignments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@sa.Staff.FullName</strong><br />
                            <small class="text-muted">@sa.Staff.Position</small>
                        </div>
                        <span class="badge bg-success">Assigned</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No staff assigned yet.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
</div>
