@model IEnumerable<PJ_P_Installation_Management_System.Models.CustomerPurchase>

@{
    ViewData["Title"] = "Customer Purchases";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">Customer Purchase Management</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Customer Purchase
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- 🔍 Compact Search Bar -->
            <form asp-action="Index" method="get" class="mb-3">
                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           class="form-control" placeholder="Search by Customer / Project..." />
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            <!-- 📋 Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Purchase Order</th>
                            <th>Customer / Project</th>
                            <th>Date</th>
                            <th>Payment Status</th>
                            <th>Installation</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.OrderId</td>
                                    <td>@order.CustomerProject</td>
                                    <td>@order.PurchaseDate.ToShortDateString()</td>

                                    <!-- Payment Status -->
                                    <td>
                                        @switch (order.PaymentStatus)
                                        {
                                            case "Completed":
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Not Paid</span>
                                                break;
                                        }
                                    </td>
                                    <!-- Installation Column -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.Status))
                                        {
                                            if (order.Status.Equals("Installation", StringComparison.OrdinalIgnoreCase) ||
                                            order.Status.Equals("With Installation", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-info text-dark">With Installation</span>
                                            }
                                            else if (order.Status.Equals("Without Installation", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-warning text-dark">Without Installation</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@order.Status</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No Installation</span>
                                        }
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@order.CustomerPurchaseId" class="btn btn-sm btn-info">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@order.CustomerPurchaseId"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this purchase?');">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No purchases found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 📑 Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    @if (ViewBag.TotalPurchases > 0)
                    {
                        <span>
                            Showing @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)
                            to @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalPurchases))
                            of @ViewBag.TotalPurchases results
                        </span>
                    }
                </div>

                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.SearchString">Previous</a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@ViewBag.SearchString">@i</a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.SearchString">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<style>
    .table {
        border-radius: 8px;
        overflow: hidden;
    }

        .table thead th {
            background-color: #4CAF50;
            color: white;
            font-weight: 500;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(76, 175, 80, 0.1);
    }

    .btn-group .btn {
        margin-right: 5px;
        border-radius: 4px;
        font-size: 0.85rem;
        padding: 0.25rem 0.5rem;
    }

        .btn-group .btn:last-child {
            margin-right: 0;
        }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .card {
        border-radius: 8px;
        border: none;
    }

    .card-body {
        padding: 1.5rem;
    }
</style>
