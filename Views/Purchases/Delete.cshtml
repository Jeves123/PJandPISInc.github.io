@model PJ_P_Installation_Management_System.Models.Purchase

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Purchase</h1>

<h4>Are you sure you want to delete this purchase?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.PurchaseDate.ToShortDateString()</dd>

    <dt class="col-sm-2">Supplier</dt>
    <dd class="col-sm-10">@Model.Supplier?.CompanyName</dd>

    <dt class="col-sm-2">Items</dt>
    <dd class="col-sm-10">@Model.PurchaseItems?.Count()</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PurchaseId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
