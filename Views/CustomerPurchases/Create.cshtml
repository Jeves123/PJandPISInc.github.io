@using PJ_P_Installation_Management_System.ViewModel
@model PJ_P_Installation_Management_System.Models.CustomerPurchase

@{
    ViewData["Title"] = "Create Customer Purchase";
    var products = ViewBag.Products as List<ProductDto>;
}

<div class="container mt-4">
    <div class="card shadow rounded-4 border-0">
        <div class="card-body p-4 p-md-5">

            <h2 class="mb-4 text-primary">
                <i class="bi bi-cart-plus"></i> Create Customer Purchase
            </h2>

            <form asp-action="Create" method="post">

                <!-- Customer Project & Status -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Customer / Project</label>
                        <input type="text" name="customerProject" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Installation Type</label>
                        <select id="status" name="Status" class="form-select" required>
                            <option value="">-- Select Installation Type --</option>
                            <option value="Installation">✓ Installation</option>
                            <option value="Without Installation">✗ Without Installation</option>
                        </select>
                    </div>
                </div>

                <!-- Installation Fields -->
                <div id="installation-fields" class="row g-3 mb-3" style="display:none;">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Installation Location</label>
                        <input type="text" name="InstallationLocation" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Installation Date</label>
                        <input type="date" name="InstallationDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Labor Fee (₱)</label>
                        <input type="number" id="laborFeeAmount" name="LaborFeeAmount" class="form-control" min="0" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Installation End Date</label>
                        <input type="date" name="InstallationEndDate" class="form-control" />
                    </div>
                </div>

                <input type="hidden" name="description" value="-" />

                <!-- Products -->
                <div class="mb-4">
                    <div class="d-flex fw-bold mb-2">
                        <div class="flex-fill">Category</div>
                        <div class="flex-fill">Product</div>
                        <div style="width:120px;">Quantity</div>
                        <div style="width:120px;">Price</div>
                        <div style="width:140px;">Total Price</div>
                        <div style="width:60px;">Action</div>
                    </div>
                    <div id="products-container"></div>
                    <button type="button" class="btn btn-outline-primary mt-2" onclick="addProductRow()">+ Add Product</button>
                </div>

                <div class="text-end fw-bold fs-5 mb-4">
                    Grand Total: <span id="grandTotal">₱0.00</span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill shadow">
                        <i class="bi bi-arrow-left-circle"></i> Back
                    </a>
                    <button type="submit" class="btn btn-success px-4 rounded-pill">
                        <i class="bi bi-credit-card"></i> Proceed to Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("products-container");
        const grandTotalEl = document.getElementById("grandTotal");
        let rowIndex = 0;

        const products = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(products));
        const descriptions = [...new Set(products.map(p => p.Description))];

        function updateGrandTotal() {
            let total = 0;
            container.querySelectorAll(".row-total").forEach(el => {
                let val = parseFloat(el.value.replace("₱","")) || 0;
                total += val;
            });
            grandTotalEl.textContent = "₱" + total.toFixed(2);
        }

        window.addProductRow = function() {
            const row = document.createElement("div");
            row.classList.add("d-flex","gap-2","mb-2","product-row");

            row.innerHTML = `
                <select class="form-select description-select flex-fill" required>
                    <option value="">-- Select Category --</option>
                    ${descriptions.map(d=>`<option value="${d}">${d}</option>`).join("")}
                </select>

                <select name="productIds[${rowIndex}]" class="form-select product-select flex-fill" required disabled>
                    <option value="">-- Select Product --</option>
                </select>

                <input type="number" name="quantities[${rowIndex}]" class="form-control qty-input" min="0" value="0" required style="width:120px;" />
                <input type="number" name="prices[${rowIndex}]" class="form-control price-input" step="0.01" min="0" required style="width:120px;" readonly />
                <input type="text" class="form-control row-total" value="₱0.00" readonly style="width:140px;" />
                <button type="button" class="btn btn-danger remove-row" style="width:60px;">X</button>
            `;

            container.appendChild(row);

            const descSelect = row.querySelector(".description-select");
            const productSelect = row.querySelector(".product-select");
            const priceInput = row.querySelector(".price-input");
            const qtyInput = row.querySelector(".qty-input");
            const totalInput = row.querySelector(".row-total");

            descSelect.addEventListener("change", function() {
                const selectedDesc = this.value;
                productSelect.innerHTML = `<option value="">-- Select Product --</option>`;

                if(selectedDesc) {
                    const filtered = products.filter(p=>p.Description===selectedDesc);
                    filtered.forEach(p=>{
                        const opt = document.createElement("option");
                        opt.value = p.ProductId;
                        opt.textContent = `${p.Name} (Stock: ${p.AvailableStock})`;
                        opt.dataset.price = p.Price;
                        opt.dataset.stock = p.AvailableStock;
                        productSelect.appendChild(opt);
                    });
                    productSelect.disabled = false;
                } else {
                    productSelect.disabled = true;
                }

                priceInput.value = "";
                totalInput.value = "₱0.00";
                updateGrandTotal();
            });

            productSelect.addEventListener("change", function() {
                const selectedOption = this.options[this.selectedIndex];
                priceInput.value = selectedOption?.dataset.price || "";
                qtyInput.value = 0;
                totalInput.value = "₱0.00";
                updateGrandTotal();
            });

            qtyInput.addEventListener("input", function() {
                const qty = parseInt(this.value) || 0;
                const price = parseFloat(priceInput.value) || 0;
                const maxStock = parseInt(productSelect.selectedOptions[0]?.dataset.stock) || 0;

                if(qty > maxStock) this.value = maxStock;

                totalInput.value = "₱" + (parseInt(this.value)*price).toFixed(2);
                updateGrandTotal();
            });

            row.querySelector(".remove-row").addEventListener("click", function() {
                row.remove();
                updateGrandTotal();
            });

            rowIndex++;
        };

        addProductRow();
    });

    // Toggle installation fields
    document.addEventListener("DOMContentLoaded", function() {
        const statusSelect = document.getElementById("status");
        const installationFields = document.getElementById("installation-fields");

        function toggleInstallationFields() {
            installationFields.style.display = statusSelect.value === "Installation" ? "flex" : "none";
        }

        statusSelect.addEventListener("change", toggleInstallationFields);
        toggleInstallationFields();
    });
</script>
