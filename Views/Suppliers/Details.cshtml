@model PJ_P_Installation_Management_System.Models.Supplier

@{
    ViewData["Title"] = "Details";
}

<h1>@Model.CompanyName</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Contact Person</dt>
    <dd class="col-sm-10">@Model.ContactPerson</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Active</dt>
    <dd class="col-sm-10">@Model.IsActive</dd>
</dl>

<hr />

<h4>Products from this Supplier</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Description</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ProductSuppliers != null && Model.ProductSuppliers.Any())
        {
            foreach (var ps in Model.ProductSuppliers)
            {
                <tr>
                    <td>@ps.Product.Name</td>
                    <td>@ps.Product.Description</td>
                    <td>
                        <form asp-action="UpdatePrice" method="post" class="d-flex">
                            <input type="hidden" name="ProductId" value="@ps.ProductId" />
                            <input type="hidden" name="SupplierId" value="@ps.SupplierId" />
                            <input type="number" step="0.01" class="form-control form-control-sm me-2"
                                   name="Price" value="@ps.Price" />
@*                             <button type="submit" class="btn btn-sm btn-primary">Save</button> *@
                        </form>
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-muted">No products linked to this supplier.</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.SupplierId" class="btn btn-warning me-2 rounded-pill px-3">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Back to List</a>

</div>
