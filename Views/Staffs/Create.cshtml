@model PJ_P_Installation_Management_System.Models.Staff

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 600px; width: 100%;">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h4 class="mb-0">Add New Staff</h4>
        </div>
        <div class="card-body p-4">

            <form asp-action="Create" method="post">
                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-bold"></label>
                    <input asp-for="FullName" class="form-control rounded-3 shadow-sm" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <!-- Gender -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Gender</label>
                    <div class="d-flex">
                        <div class="form-check me-3">
                            <input class="form-check-input" type="radio" asp-for="Gender" value="Male" />
                            <label class="form-check-label">Male</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="Gender" value="Female" />
                            <label class="form-check-label">Female</label>
                        </div>
                    </div>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <!-- Position -->
                <div class="mb-3">
                    <label asp-for="Position" class="form-label fw-bold">Position</label>

                    <!-- Dropdown bound to Position -->
                    <select asp-for="Position" id="positionSelect" class="form-select rounded-3 shadow-sm">
                        <option value="">-- Select Position --</option>
                        @foreach (var pos in ViewBag.Positions as List<string>)
                        {
                            <option value="@pos">@pos</option>
                        }
                        <option value="__other__">Other (Type Manually)</option>
                    </select>

                    <!-- Manual Input (only shown when Other selected) -->
                    <input type="text" id="manualPosition"
                           class="form-control rounded-3 shadow-sm mt-2 d-none"
                           placeholder="Enter custom position" />

                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>


                <!-- Location -->
                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-bold"></label>
                    <input asp-for="Location" class="form-control rounded-3 shadow-sm" placeholder="Enter location" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <!-- Contact Number -->
                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label fw-bold"></label>
                    <input asp-for="ContactNumber" class="form-control rounded-3 shadow-sm" placeholder="Enter contact number" />
                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" class="form-control rounded-3 shadow-sm" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Action buttons -->
                <div class="d-flex justify-content-between align-items-center mt-4">

                     @*<a asp-action="Index" class="btn btn-outline-info rounded-3 shadow-sm">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a> *@

                    <!-- Right-side buttons -->
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary me-2 rounded-3">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-3 shadow">Save Staff</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const positionSelect = document.getElementById("positionSelect");
            const manualInput = document.getElementById("manualPosition");

            function toggleManualInput() {
                if (positionSelect.value === "__other__") {
                    manualInput.classList.remove("d-none");
                    manualInput.setAttribute("name", "Position"); // bind to model
                    positionSelect.removeAttribute("name"); // unbind dropdown
                    manualInput.value = "";
                    manualInput.focus();
                } else {
                    manualInput.classList.add("d-none");
                    manualInput.removeAttribute("name"); // unbind text
                    positionSelect.setAttribute("name", "Position"); // bind dropdown
                }
            }

            positionSelect.addEventListener("change", toggleManualInput);
            toggleManualInput(); // run on load
        });
    </script>
}
